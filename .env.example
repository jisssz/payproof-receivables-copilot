# =============================================================================
# PayProof Environment Configuration Template
# COPY TO .env (DO NOT COMMIT SECRETS TO GIT)
# =============================================================================

# Backend Configuration
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-payproof.vercel.app

# Optional AI Integration (OpenAI)
# If omitted or left empty, PayProof runs in deterministic template mode
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration (in frontend/.env)
# VITE_API_URL=https://your-payproof-backend.onrender.com
